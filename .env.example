# Copy to .env for local use. On Render/DigitalOcean these are set in the
# host's dashboard instead, so the secrets never sit in the repository.

NODE_ENV=production
PORT=3000

# Where the SQLite database file lives. On Render this must point at the mounted
# disk (/var/data), otherwise every deploy starts with an empty ticket list.
DATA_DIR=/var/data

# Signs the login cookie. Any long random string; changing it signs everyone out.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Only used the very first time the app starts, to create the first
# administrator. Ignored once any account exists.
ADMIN_EMAIL=office@yourschool.org
ADMIN_NAME=Front Office
ADMIN_PASSWORD=

# Optional — trial mode, for showing the portal to people before it goes live.
#
# A free host has no permanent storage: the database is wiped whenever the
# service sleeps or redeploys. These two settings rebuild a sensible starting
# state on boot, so the portal is never sitting there empty. Both only ever run
# when the table in question is empty, so on a paid host with a disk attached
# they do nothing after the first start. Remove them at go-live.
#
# One account per line: Name | email | admin or staff | password
SEED_USERS=
# 1 = create a handful of example maintenance requests if there are none.
DEMO_TICKETS=

# Optional — email notifications. Leave SMTP_HOST empty and the portal works
# exactly the same, just without emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional — people who should be told about URGENT requests even though they are
# not administrators in the portal (a facilities director, for example).
# Separate several with commas, semicolons or one per line. Ordinary requests
# still go to administrators only.
URGENT_ALERT_EMAILS=

# Optional — the "for an emergency, call ... directly" notice at the top of the
# request form. Normally typed in on the Staff tab and left alone; these are only
# used to fill it in when it has never been set, which is what keeps it on the
# form through the free host's nightly wipe. Whatever the office types in the
# portal wins over these.
EMERGENCY_CONTACT_NAME=
EMERGENCY_CONTACT_PHONE=
EMERGENCY_CONTACT_NOTE=
